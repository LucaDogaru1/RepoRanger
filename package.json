{
  "name": "repo-ranger",
  "version": "1.1.9",
  "description": "RepoRanger — static code graph scanner and navigation CLI for AI-assisted development. Supports PHP/Laravel, JavaScript/TypeScript, Vue, and Nuxt.",
  "main": "bin/repo-ranger.js",
  "bin": {
    "repo-ranger": "bin/repo-ranger.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "scripts/",
    "config/architecture_scan/laravel.example.json",
    "repo-ranger.config.example.json",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/cli/scan.ts",
    "analyze:impact": "tsx src/cli/commands/impact.ts",
    "analyze:cycles": "tsx src/cli/commands/cycles.ts",
    "analyze:dead-code": "tsx src/cli/commands/deadCode.ts",
    "analyze:architecture": "tsx src/cli/commands/architecture.ts",
    "analyze:hotspots": "tsx src/cli/commands/hotspots.ts",
    "analyze:change-impact": "tsx src/cli/commands/changeImpact.ts",
    "analyze:ai-context": "tsx src/cli/commands/aiContext.ts",
    "analyze:find": "tsx src/cli/commands/find.ts",
    "feature": "tsx src/cli/commands/feature.ts",
    "context": "tsx src/cli/commands/context.ts",
    "similar": "tsx src/cli/commands/similar.ts",
    "analyze:locate": "tsx src/cli/commands/locate.ts",
    "analyze:trace": "tsx src/cli/commands/trace.ts",
    "locate": "tsx src/cli/commands/locate.ts",
    "trace": "tsx src/cli/commands/trace.ts",
    "test:nested-response-fields": "tsx test/scanner/php/astHandlers/node_types/returnStatement.test.ts",
    "test:search-query-variants": "tsx test/graph/queries/searchQueryVariants.test.ts",
    "test:route-search-variants": "tsx test/graph/queries/routeSearchVariants.test.ts",
    "test:route-search": "tsx test/graph/queries/routeSearch.integration.test.ts",
    "test:symbol-search": "tsx test/graph/queries/symbolSearch.integration.test.ts",
    "test:route-file-extractor": "tsx test/scanner/php/routes/routeFileExtractor.test.ts",
    "test:call-chain": "tsx test/graph/queries/callChainQueries.test.ts",
    "test:navigation": "tsx test/analyzers/navigation/navigation.test.ts",
    "test:nuxt-strip-typescript": "tsx test/scanner/js/nuxt/stripTypescript.test.ts",
    "test:ts-parser": "tsx test/scanner/js/ts/tsParser.test.ts",
    "test:vue-ts-script": "tsx test/scanner/js/vue/processVueFile.test.ts",
    "test:nuxt-fetch": "tsx test/scanner/js/resolvers/nuxtFetchExtractor.test.ts",
    "test:import-resolution": "tsx test/scanner/js/resolvers/resolveImportPath.test.ts",
    "analyze:risk": "tsx src/cli/commands/risk.ts",
    "smoke:real-db": "npm run smoke:real-db:fast",
    "smoke:real-db:fast": "npm run analyze:cycles -- sqlite/Graph.sqlite --limit=10 && npm run analyze:architecture -- sqlite/Graph.sqlite --include-depends-on --ignore-likely-false-positives --limit=10 && npm run analyze:hotspots -- sqlite/Graph.sqlite --limit=10 && npm run analyze:risk -- sqlite/Graph.sqlite --limit=10 && npm run analyze:ai-context -- sqlite/Graph.sqlite \"SpOTTBackend\\Services\\Content\\Search\\SearchService::buildParamsFromRequest\" --compact",
    "smoke:real-db:full": "npm run smoke:real-db:fast && npm run analyze:dead-code -- sqlite/Graph.sqlite --limit=10 && npm run analyze:change-impact -- sqlite/Graph.sqlite \"SpOTTBackend\\Services\\Content\\Search\\SearchService::buildParamsFromRequest\" --depth=2 --limit=10"
  },
  "keywords": [
    "static-analysis",
    "code-graph",
    "php",
    "vue",
    "laravel",
    "impact-analysis",
    "cursor",
    "cli",
    "repo-ranger",
    "RepoRanger"
  ],
  "author": "Luca Dogaru",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaDogaru1/RepoRanger.git"
  },
  "homepage": "https://github.com/LucaDogaru1/RepoRanger#readme",
  "bugs": {
    "url": "https://github.com/LucaDogaru1/RepoRanger/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-php": "^0.22.8",
    "tree-sitter-typescript": "^0.21.2",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
